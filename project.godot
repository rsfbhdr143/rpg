; Файл настроек проекта Godot 4.

config_version=5

[application]

config/name="DOS-like RPG Skeleton"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[autoload]

Audio="*res://scripts/audio/audio_manager.gd"
